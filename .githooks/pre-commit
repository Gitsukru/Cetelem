#!/bin/sh
#
# Hook git pre-commit pour mettre à jour automatiquement la version du Service Worker
#
# Installation:
#   git config core.hooksPath .githooks
#
# Ou manuellement:
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

# Vérifier si des fichiers JS ou CSS ont été modifiés
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|css|html)$' | grep -v 'sw.js' | grep -v 'node_modules')

if [ -n "$CHANGED_FILES" ]; then
    echo "📦 Fichiers JS/CSS/HTML modifiés détectés, mise à jour du Service Worker..."

    # Exécuter le script de mise à jour
    if command -v node &> /dev/null; then
        node scripts/update-sw-version.js
    else
        echo "⚠️ Node.js non trouvé, mise à jour manuelle du sw.js nécessaire"
    fi
fi

exit 0
