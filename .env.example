# Configuration Backend
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_ici

# Infomaniak (futur)
INFOMANIAK_API_URL=https://api-zikirmatik.jelastic.infomaniak.com
INFOMANIAK_API_KEY=votre_cle_api_ici

# Provider actif ('supabase' ou 'infomaniak')
ACTIVE_PROVIDER=supabase

# Monitoring Sentry (optionnel - recommandé pour 10k+ users)
# Gratuit jusqu'à 5000 erreurs/mois sur https://sentry.io
# Créer projet JavaScript et copier le DSN
VITE_SENTRY_DSN=https://your-key@sentry.io/project-id
